# Moisés server configuration. Copy to server/.env (git-ignored) or set the
# variables in the environment. Anything left empty uses the default shown.
# Every value is validated at startup; an invalid one stops the server with a
# message naming the variable. There are no secrets here: session tokens and
# game seeds are generated by the server at runtime.

# --- server -------------------------------------------------------------------
# development | production | test. In production CORS_ORIGIN is required.
NODE_ENV=
# Interface to listen on (default 0.0.0.0).
HOST=
# Port (default 3000; 0 = any free port).
PORT=
# Allowed browser origins, comma separated, e.g. https://moises.example
# Default (development only): http://localhost:5173,http://127.0.0.1:5173
# "*" is refused in production.
CORS_ORIGIN=
# Reverse proxies in front of the server whose X-Forwarded-For is trusted for
# per-IP limits (default 0 = use the TCP peer address).
TRUST_PROXY_HOPS=
# silent | error | warn | info | debug (default info).
LOG_LEVEL=

# Folder with the built client (client/dist). When set, the server also serves
# the web app from the same origin and port (assets cached, index.html no-store,
# CSP and other security headers). Empty = API only (/health + Socket.IO).
STATIC_DIR=

# --- limits -------------------------------------------------------------------
# Largest Socket.IO message accepted, in bytes (default 16384).
MAX_MESSAGE_BYTES=
# Simultaneous connections, total and per IP (defaults 2000 and 20).
MAX_CONNECTIONS=
MAX_CONNECTIONS_PER_IP=
# Rooms at once, total and created from the same IP (defaults 500 and 5).
MAX_ROOMS=
MAX_ROOMS_PER_IP=
# Per-connection token bucket: burst, refill per second, and consecutive
# refused messages before disconnecting (defaults 20, 10, 50).
RATE_LIMIT_BURST=
RATE_LIMIT_PER_SECOND=
RATE_LIMIT_DISCONNECT_AFTER=
# Guessing room codes: wrong codes one IP may try inside a window before
# "room:join" answers RATE_LIMITED until the window ends (defaults 20 and 300000).
JOIN_FAIL_MAX=
JOIN_FAIL_WINDOW_MS=

# --- rooms --------------------------------------------------------------------
# Room code length, 4-12 (default 6).
ROOM_CODE_LENGTH=
# Close a room after this long without human activity (default 1800000 = 30 min).
ROOM_IDLE_TTL_MS=
# Close a room after this long without any connected human (default 120000 = 2 min).
ROOM_EMPTY_TTL_MS=
# In the lobby, a disconnected player loses the seat after this long (default 60000).
LOBBY_RECONNECT_GRACE_MS=
# How often the cleanup runs (default 15000).
ROOM_SWEEP_INTERVAL_MS=

# --- bots ---------------------------------------------------------------------
# Bots wait a random time in this range before each move (defaults 600 and 1400).
BOT_DELAY_MIN_MS=
BOT_DELAY_MAX_MS=

# --- game rule timings (milliseconds, whole numbers, 250-60000) ---------------
# Defaults in server/src/config/rules.ts.
MOISES_ARRANGE_MS=
MOISES_INITIAL_PEEK_MS=
MOISES_REACTION_WINDOW_MS=
# Time to choose cards after claiming the reaction window with claimReaction (default 8000).
MOISES_REACTION_CLAIM_MS=
MOISES_REVEAL_MS=
# Turn timer: time for each decision of the current player (default 15000).
# Whole seconds, 5000-60000 (also the default of the table settings).
MOISES_TURN_MS=
