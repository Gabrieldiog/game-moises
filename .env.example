# Usado pelo docker-compose.yml (copie para .env; .env não vai para o git).
# Endereço público, sem barra no final.
VITE_SERVER_URL=https://moises.example.com
CORS_ORIGIN=https://moises.example.com
# 1 = há um proxy (Caddy) na frente; 0 = porta exposta direto.
TRUST_PROXY_HOPS=1
# Porta no host (o contêiner sempre usa 3000).
PORT=3000
LOG_LEVEL=info
